+}
+
+// Clients using ext-background-effect (e.g. foot) only get blur where they ask
+// for it, and an opaque client asks for none. A shader that introduces
+// transparency still needs the blur behind it, unless no_blur is set.
+namespace _ns_shouldBlurWindow
+{
+    bool (*original)(Render::IHyprRenderer*, PHLWINDOW) = nullptr;
+    bool hook(Render::IHyprRenderer* thisptr, PHLWINDOW window)
+    {
+        if (original(thisptr, window))
+            return true;
+
+        static auto PBLUR = CConfigValue<Config::INTEGER>("decoration:blur:enabled");
+        if (!*PBLUR || thisptr->m_bRenderingSnapshot || !window || window->m_ruleApplicator->noBlur().valueOrDefault() ||
+            window->m_ruleApplicator->RGBX().valueOrDefault())
+            return false;
+
+        auto config = g.Manager.GetShaderForElement(window);
+        return config && config->ActiveShader->Transparency;
+    }
+    auto registerShouldBlurWindow = []
+    {
+        g.Hooks.push_back(
+            { "Render::IHyprRenderer",
+              "shouldBlur(Hyprutils::Memory::CSharedPointer<Desktop::View::CWindow>)",
+              (void**) &original,
+              (void*) hook }
+        );
+        return true;
+    }();
+}
